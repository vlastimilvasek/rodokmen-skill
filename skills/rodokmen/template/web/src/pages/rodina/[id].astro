---
import Base from '../../layouts/Base.astro';
import PersonLink from '../../components/PersonLink.astro';
import Record from '../../components/Record.astro';
import { people, families, lineByK, records, href, birthLabel } from '../../lib/data.js';

export function getStaticPaths() {
  return Object.keys(families).map((id) => ({ params: { id } }));
}
const f = families[Astro.params.id];
const father = f.father ? people[f.father] : null;
const mother = f.mother ? people[f.mother] : null;
const children = f.children.map((s) => people[s]);
// děti: přímí předci + sourozenci, chronologicky podle narození
const kids = [
  ...children.map((c) => ({ ancestor: true, slug: c.slug, name: c.name, years: c.years, sort: c.sort, url: href.person(c.slug),
    text: c.facts.slice(0, 3).join(' · '), rel: c.rel, nrec: c.records.length })),
  ...f.side.filter((s) => s.sib).map((s) => ({ ancestor: false, slug: s.slug, name: s.name, sort: s.sort, url: href.relative(s.slug),
    text: s.text, nrec: s.records.length })),
].sort((a, b) => a.sort - b.sort);
const others = f.side.filter((s) => !s.sib);
const line = f.line ? lineByK[f.line] : null;
const title = [father?.name ?? (f.fatherUnknown ? 'otec neuveden' : 'neznámý otec'), mother?.name ?? 'neznámá matka'].join(' a ');
---
<Base title={`Rodina: ${title}`}>
  <p class="crumbs">Rodina{line && <> · <a href={href.line(line.slug)}>rod {line.name}</a></>}</p>
  <h1>{title}</h1>

  <div class="grid2">
    {[father, mother].map((p, i) => (
      <div class="card">
        <h3>{i === 0 ? 'Otec' : 'Matka'}</h3>
        {p ? (
          <>
            <p><PersonLink slug={p.slug} /><br /><span class="small muted">{p.rel}</span></p>
            {p.facts.length > 0 && <ul class="facts small">{p.facts.map((x) => <li>{x}</li>)}</ul>}
            {p.family && <p class="small"><a href={href.family(p.family)}>Rodina, ze které pochází →</a></p>}
          </>
        ) : <p class="muted">{i === 0 && f.fatherUnknown ? 'V zápisech neuveden – dítě se narodilo jako nemanželské.' : 'Zatím neznámá osoba.'}</p>}
      </div>
    ))}
  </div>

  {f.marriage.length > 0 && (
    <>
      <h2>Sňatek</h2>
      <ul class="facts">{f.marriage.map((m) => <li>{m.replace(/^×\s*/, '')}</li>)}</ul>
    </>
  )}

  <h2>Děti</h2>
  <div class="kids">
    {kids.map((c) => (
      <a class={`card card-link kid${c.ancestor ? ' kid-anc' : ''}`} href={c.url}>
        <h3>{c.name}{c.years && <span class="yrs"> {c.years}</span>}</h3>
        <p class="small kid-meta">{c.ancestor ? <strong>přímý předek – {c.rel}</strong> : 'sourozenec'}{birthLabel(c.sort) && <> · {birthLabel(c.sort)}</>}{c.nrec > 0 && <> · {c.nrec} {c.nrec === 1 ? 'zápis' : c.nrec < 5 ? 'zápisy' : 'zápisů'}</>}</p>
        {c.text && <p class="small">{c.text}</p>}
      </a>
    ))}
  </div>
  <p class="small muted">Další sourozence zatím systematicky nehledáme – tady jsou jen ti, na které jsme narazili.</p>
  {others.length > 0 && (
    <>
      <h2>Další příbuzní</h2>
      <div class="grid2">{others.map((s) => <a class="card card-link" href={href.relative(s.slug)}><h3>{s.name}</h3><p class="small">{s.text}</p></a>)}</div>
    </>
  )}

  {f.records.length > 0 && (
    <>
      <h2>Zápisy</h2>
      <div class="recs">{f.records.filter((r) => records[r]).map((r) => <Record id={r} />)}</div>
    </>
  )}
</Base>
