---
// Phone-friendly pedigree: parents, grandparents and great-grandparents as stacked two-column grids.
// k = Kekulé number of a direct ancestor; root = reference {kind: 'relative', slug} for a relative outside the line.
import { byK, lineByK, people, pedigreeCols } from '../lib/data.js';
const { k, root } = Astro.props;
const start = root ?? { kind: 'person', slug: byK[k]?.slug };
const cols = pedigreeCols(start, 3);
const labels = ['Rodiče', 'Prarodiče', 'Praprarodiče'];
const depth = (kk) => (byK[2 * kk] || byK[2 * kk + 1] ? 1 + Math.max(depth(2 * kk), depth(2 * kk + 1)) : 0);
const genWord = (n) => (n < 5 ? 'generace' : 'generací');
---
<div class="mtree">
  {labels.map((label, li) => (
    <section>
      <h3>{label}</h3>
      <div class="mtree-grid">
        {cols[li + 1].map((node) => {
          if (!node) return <span class="mbox empty">?</span>;
          const b = node.box;
          const line = b.slug && people[b.slug]?.line ? lineByK[people[b.slug].line] : null;
          const more = li === labels.length - 1 && node.kk ? depth(node.kk) : 0;
          const inner = <><strong>{b.name}</strong><span>{b.years}</span>{more > 0 && <span class="more">a dál {more} {genWord(more)} →</span>}</>;
          return b.url
            ? <a class="mbox" href={b.url} style={line ? `border-left-color:${line.color}` : undefined}>{inner}</a>
            : <span class="mbox plain">{inner}</span>;
        })}
      </div>
    </section>
  ))}
</div>
