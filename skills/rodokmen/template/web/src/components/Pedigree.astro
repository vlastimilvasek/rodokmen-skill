---
// Four columns: the person, parents, grandparents, great-grandparents.
// k = Kekulé number of a direct ancestor; root = reference {kind: 'relative', slug} for a relative outside the line
// (their parents come from otec/matka fields or, for a sibling, from the ancestor's parents).
// Boxes in the last column show how many more known generations continue behind them.
import { byK, pedigreeCols } from '../lib/data.js';
const { k, root } = Astro.props;
const start = root ?? { kind: 'person', slug: byK[k]?.slug };
const cols = pedigreeCols(start, 3);
const depth = (kk) => (byK[2 * kk] || byK[2 * kk + 1] ? 1 + Math.max(depth(2 * kk), depth(2 * kk + 1)) : 0);
const known = (kk) => (byK[kk] ? 1 + known(2 * kk) + known(2 * kk + 1) : 0);
const genWord = (n) => (n === 1 ? 'generace' : n < 5 ? 'generace' : 'generací');
---
<div class="pedigree" role="list" aria-label="Rodokmen tři generace nazpět">
  {cols.map((col, c) => {
    const span = 8 / col.length;
    return col.map((node, i) => {
      const style = `grid-column:${c + 1};grid-row:${1 + i * span} / span ${span}`;
      const more = c === 3 && node?.kk ? depth(node.kk) : 0;
      if (!node) return <span role="listitem" class="box empty" style={style}>?</span>;
      const b = node.box;
      const cls = `box ${c === 0 ? 'self' : ''} ${more ? 'has-more' : ''}`;
      const inner = <>{b.name}<span class="y">{b.years || ' '}</span>{more > 0 && <span class="more">a dál {more} {genWord(more)} →</span>}</>;
      return b.url
        ? <a role="listitem" class={cls} style={style} href={b.url} title={more ? `Rodokmen pokračuje: ${known(node.kk) - 1} dalších předků` : undefined}>{inner}</a>
        : <span role="listitem" class={`${cls} plain`} style={style}>{inner}</span>;
    });
  })}
</div>
